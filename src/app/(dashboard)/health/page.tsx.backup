"use client";

import { useState, useEffect, useMemo } from "react";
import { createClient } from "@/lib/supabase/client";
import {
  Card,
  Badge,
  Button,
  Tabs,
  TabsList,
  TabsTrigger,
  Progress,
  Spinner,
} from "@/components/ui";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
} from "recharts";
import {
  Heart,
  Moon,
  Activity,
  Zap,
  RefreshCw,
  Check,
  TrendingUp,
  TrendingDown,
  Minus,
  AlertTriangle,
  CheckCircle,
  Info,
} from "lucide-react";

interface DailyMetrics {
  date: string;
  recovery_score: number | null;
  hrv_ms: number | null;
  resting_hr: number | null;
  sleep_duration_minutes: number | null;
  sleep_score: number | null;
  sleep_deep_minutes: number | null;
  sleep_rem_minutes: number | null;
  sleep_light_minutes: number | null;
  sleep_awake_minutes: number | null;
  sleep_start_at: string | null;
  sleep_end_at: string | null;
  sleep_needed_minutes: number | null;
  strain: number | null;
  stress_level: number | null;
  mood: number | null;
  fatigue_level: number | null;
  notes: string | null;
}

interface TrainingLoad {
  date: string;
  daily_tss: number | null;
  ctl: number | null;
  atl: number | null;
  tsb: number | null;
}

export default function HealthPage() {
  const supabase = createClient();
  const [period, setPeriod] = useState<"7" | "30">("7");
  const [metrics, setMetrics] = useState<DailyMetrics[]>([]);
  const [trainingLoad, setTrainingLoad] = useState<TrainingLoad[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [lastSync, setLastSync] = useState<Date | null>(null);
  const [physio, setPhysio] = useState<{
    weight_kg: number | null;
    height_cm: number | null;
  } | null>(null);
  const [trendHover, setTrendHover] = useState<DailyMetrics | null>(null);
  const [trendHoverLabel, setTrendHoverLabel] = useState("");
  const [trendSelection, setTrendSelection] = useState<DailyMetrics | null>(
    null
  );
  const [trendSelectionLabel, setTrendSelectionLabel] = useState("");
  const [showSubjectiveForm, setShowSubjectiveForm] = useState(false);
  const [subjectiveData, setSubjectiveData] = useState({
    stress_level: 5,
    fatigue_level: 5,
    mood: 3,
    notes: "",
  });

  useEffect(() => {
    loadMetrics();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [period]);

  const saveSubjectiveMetrics = async () => {
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) return;

      const today = new Date().toISOString().split("T")[0];

      // Check if entry exists
      const { data: existing } = await supabase
        .from("daily_metrics")
        .select("id")
        .eq("user_id", user.id)
        .eq("date", today)
        .single();

      let error;
      if (existing) {
        // Update existing entry
        const result = await supabase
          .from("daily_metrics")
          .update({
            stress_level: subjectiveData.stress_level,
            fatigue_level: subjectiveData.fatigue_level,
            mood: subjectiveData.mood,
            notes: subjectiveData.notes,
            updated_at: new Date().toISOString(),
          })
          .eq("user_id", user.id)
          .eq("date", today);
        error = result.error;
      } else {
        // Insert new entry
        const result = await supabase.from("daily_metrics").insert({
          user_id: user.id,
          date: today,
          stress_level: subjectiveData.stress_level,
          fatigue_level: subjectiveData.fatigue_level,
          mood: subjectiveData.mood,
          notes: subjectiveData.notes,
          source: "manual",
        });
        error = result.error;
      }

      if (error) {
        console.error("Error saving subjective metrics:", error);
        alert("Erreur lors de la sauvegarde. Voir la console pour plus de détails.");
        return;
      }

      setShowSubjectiveForm(false);
      console.log("Subjective metrics saved, reloading data...");
      await loadMetrics(); // Reload to show updated data
      console.log("Data reloaded successfully");
    } catch (error) {
      console.error("Error saving subjective metrics:", error);
      alert("Erreur lors de la sauvegarde. Voir la console pour plus de détails.");
    }
  };

  const syncWhoop = async () => {
    try {
      const response = await fetch("/api/sync/whoop", {
        method: "POST",
      });

      if (!response.ok) {
        throw new Error("Sync failed");
      }

      await loadMetrics();
    } catch (error) {
      console.error("Error syncing WHOOP:", error);
      alert("Erreur lors de la synchronisation WHOOP");
    }
  };

  const loadMetrics = async () => {
    setIsLoading(true);
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) return;

      const daysAgo = parseInt(period);
      const startDate = new Date();
      startDate.setDate(startDate.getDate() - daysAgo);

      const { data, error: metricsError } = await supabase
        .from("daily_metrics")
        .select("*")
        .eq("user_id", user.id)
        .gte("date", startDate.toISOString().split("T")[0])
        .order("date");

      if (metricsError) {
        console.error("Error loading metrics:", metricsError);
      }

      if (data) {
        setMetrics(data);
      }

      // Load training load data
      const { data: loadData, error: loadError } = await supabase
        .from("training_load")
        .select("*")
        .eq("user_id", user.id)
        .gte("date", startDate.toISOString().split("T")[0])
        .order("date");

      if (loadError) {
        console.error("Error loading training load:", loadError);
      }

      if (loadData) {
        setTrainingLoad(loadData);
      }

      const { data: physioData } = await supabase
        .from("physiological_data")
        .select("weight_kg, height_cm")
        .eq("user_id", user.id)
        .single();
      if (physioData) {
        setPhysio({
          weight_kg: physioData.weight_kg,
          height_cm: physioData.height_cm,
        });
      }

      // Get last sync time
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const { data: integration } = await (supabase as any)
        .from("integrations")
        .select("last_sync_at")
        .eq("user_id", user.id)
        .eq("provider", "whoop")
        .single();

      if (integration?.last_sync_at) {
        setLastSync(new Date(integration.last_sync_at));
      }
    } finally {
      setIsLoading(false);
    }
  };

  const displayMetrics = useMemo(
    () => (metrics.length > 0 ? metrics : []),
    [metrics]
  );

  const formatDate = (dateStr: string) => {
    const date = new Date(dateStr);
    return date.toLocaleDateString("fr-FR", { weekday: "short" });
  };

  const getRecoveryStatus = (score: number) => {
    if (score >= 67)
      return { label: "Optimal", color: "text-success", bg: "bg-success/20", variant: "success" as const };
    if (score >= 34)
      return { label: "Modéré", color: "text-warning", bg: "bg-warning/20", variant: "warning" as const };
    return { label: "Faible", color: "text-error", bg: "bg-error/20", variant: "error" as const };
  };

  const getHRVStatus = (hrv: number, avg: number) => {
    const diff = hrv - avg;
    const percent = (diff / avg) * 100;
    if (percent > 5)
      return {
        label: "Élevé",
        color: "text-success",
        change: `+${percent.toFixed(1)}% vs moy.`,
      };
    if (percent < -5)
      return {
        label: "Bas",
        color: "text-error",
        change: `${percent.toFixed(1)}% vs moy.`,
      };
    return {
      label: "Normal",
      color: "text-accent",
      change: `${percent > 0 ? "+" : ""}${percent.toFixed(1)}% vs moy.`,
    };
  };

  const getStressStatus = (stress: number) => {
    if (stress <= 2) return { label: "Faible", color: "text-success" };
    if (stress <= 3) return { label: "Normal", color: "text-accent" };
    if (stress <= 4)
      return { label: "Légèrement Élevé", color: "text-warning" };
    return { label: "Élevé", color: "text-error" };
  };

  // Calculate averages
  const hrvValues = displayMetrics
    .map((m) => m.hrv_ms)
    .filter((v): v is number => v !== null && v > 0);

  const avgHRV =
    hrvValues.length > 0
      ? Math.round(
          hrvValues.reduce((sum, v) => sum + v, 0) / hrvValues.length
        )
      : 0;

  // HRV Baseline (zone normale)
  const hrvStdDev =
    hrvValues.length > 1
      ? Math.sqrt(
          hrvValues.reduce((sum, v) => sum + Math.pow(v - avgHRV, 2), 0) /
            (hrvValues.length - 1)
        )
      : 0;
  const hrvBaselineMin = Math.max(0, avgHRV - hrvStdDev);
  const hrvBaselineMax = avgHRV + hrvStdDev;

  // Average resting HR
  const avgRestingHR =
    displayMetrics.length > 0
      ? Math.round(
          displayMetrics.reduce((sum, m) => sum + (m.resting_hr || 0), 0) /
            displayMetrics.length
        )
      : 0;

  // Sleep debt (last 14 days, weighted towards recent days - WHOOP logic)
  const sleepDebt = useMemo(() => {
    // Get last 14 days of data
    const last14Days = displayMetrics.slice(-14);
    if (last14Days.length === 0) return 0;

    // Calculate weighted sleep debt (more weight on recent days)
    let totalDebt = 0;
    let totalWeight = 0;

    last14Days.forEach((m, index) => {
      const needed = m.sleep_needed_minutes || 480; // Default 8h
      const actual = m.sleep_duration_minutes || 0;
      const dailyDebt = actual - needed;

      // Weight increases linearly from day 0 (oldest) to day 13 (most recent)
      // Day 0 gets weight 1, day 13 gets weight 14
      const weight = index + 1;

      totalDebt += dailyDebt * weight;
      totalWeight += weight;
    });

    return totalWeight > 0 ? Math.round(totalDebt / totalWeight) : 0;
  }, [displayMetrics]);

  const formatSleepDebt = (minutes: number) => {
    const absMinutes = Math.abs(minutes);
    const h = Math.floor(absMinutes / 60);
    const m = absMinutes % 60;
    const sign = minutes < 0 ? "-" : "+";
    return `${sign}${h}h${m.toString().padStart(2, "0")}`;
  };

  // Format time since last sync
  const formatTimeSince = (date: Date | null) => {
    if (!date) return null;

    const now = Date.now();
    const diff = now - date.getTime();
    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    const days = Math.floor(diff / 86400000);

    if (days > 0) return `il y a ${days}j`;
    if (hours > 0) return `il y a ${hours}h`;
    return `il y a ${minutes}m`;
  };

  const todayData =
    displayMetrics.length > 0
      ? displayMetrics[displayMetrics.length - 1]
      : null;

  const todayLoad =
    trainingLoad.length > 0 ? trainingLoad[trainingLoad.length - 1] : null;

  // Readiness Score (synthèse intelligente)
  const calculateReadinessScore = () => {
    if (!todayData) return null;

    let score = 0;
    let count = 0;

    // Recovery score (40% weight)
    if (todayData.recovery_score !== null) {
      score += todayData.recovery_score * 0.4;
      count += 0.4;
    }

    // HRV status (30% weight)
    if (todayData.hrv_ms !== null && avgHRV > 0) {
      const hrvPercent = (todayData.hrv_ms / avgHRV) * 100;
      const hrvScore = Math.min(100, Math.max(0, hrvPercent));
      score += hrvScore * 0.3;
      count += 0.3;
    }

    // Sleep quality (20% weight)
    if (todayData.sleep_score !== null) {
      score += todayData.sleep_score * 0.2;
      count += 0.2;
    }

    // TSB - Training Stress Balance (10% weight)
    if (todayLoad && todayLoad.tsb !== null) {
      // TSB optimal entre -10 et +10
      const tsbScore = Math.max(
        0,
        Math.min(100, 50 + todayLoad.tsb * 5)
      );
      score += tsbScore * 0.1;
      count += 0.1;
    }

    return count > 0 ? Math.round(score / count) : null;
  };

  const readinessScore = calculateReadinessScore();

  const getReadinessInterpretation = (score: number | null) => {
    if (score === null) return null;

    const hrvBelowBaseline =
      todayData &&
      todayData.hrv_ms !== null &&
      todayData.hrv_ms < hrvBaselineMin;

    const restingHRHigh =
      todayData &&
      todayData.resting_hr !== null &&
      avgRestingHR > 0 &&
      todayData.resting_hr > avgRestingHR + 5;

    const sleepDeficit = sleepDebt < -120; // Plus de 2h de dette

    if (score >= 85) {
      if (hrvBelowBaseline || restingHRHigh) {
        return "Ton score est bon, mais ton système nerveux montre des signes de fatigue. Privilégie une séance légère aujourd'hui.";
      }
      return "Ton système nerveux est parfaitement remis. C'est le jour idéal pour ta séance de fractionné ou ton entraînement clé.";
    }

    if (score >= 70) {
      if (sleepDeficit) {
        return "Ta forme est correcte mais tu accumules une dette de sommeil. Une séance modérée est recommandée.";
      }
      return "Tu es en bonne condition pour t'entraîner. Évite les intensités maximales mais tu peux faire une sortie de qualité.";
    }

    if (score >= 50) {
      return "Ta récupération est incomplète. Privilégie une séance facile en endurance ou un jour de repos actif.";
    }

    if (hrvBelowBaseline && restingHRHigh) {
      return "Ton système nerveux est en sur-stress. Ton corps a besoin de repos. Surveille ton hydratation et considère un jour OFF complet.";
    }

    return "Ta récupération est faible. Ton corps a besoin de repos. C'est le moment idéal pour un jour de récupération complète.";
  };

  const recoveryStatus = todayData?.recovery_score
    ? getRecoveryStatus(todayData.recovery_score)
    : null;
  const hrvStatus =
    todayData?.hrv_ms !== undefined
      ? getHRVStatus(todayData.hrv_ms || 0, avgHRV || todayData.hrv_ms || 1)
      : null;
  const stressStatus = todayData?.strain
    ? getStressStatus(todayData.strain)
    : null;

  const formatSleepDuration = (mins: number) => {
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    return `${h}h${m.toString().padStart(2, "0")}m`;
  };

  const formatClockTime = (mins: number) => {
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    return `${h.toString().padStart(2, "0")}h${m.toString().padStart(2, "0")}`;
  };

  // Generate Coach AI insights
  const generateCoachInsights = () => {
    const insights: { type: "warning" | "info" | "success"; text: string }[] =
      [];

    if (!todayData || displayMetrics.length < 3) return insights;

    // Check HRV drop after training
    const lastThreeDays = displayMetrics.slice(-3);
    const hrvDropped =
      lastThreeDays.length >= 2 &&
      lastThreeDays[lastThreeDays.length - 1].hrv_ms !== null &&
      lastThreeDays[lastThreeDays.length - 2].hrv_ms !== null &&
      lastThreeDays[lastThreeDays.length - 1].hrv_ms! <
        lastThreeDays[lastThreeDays.length - 2].hrv_ms! * 0.9;

    if (hrvDropped) {
      const isRecovering =
        lastThreeDays.length >= 3 &&
        lastThreeDays[lastThreeDays.length - 1].hrv_ms! >
          lastThreeDays[lastThreeDays.length - 3].hrv_ms!;

      if (isRecovering) {
        insights.push({
          type: "success",
          text: "Ta HRV remonte progressivement après ta dernière séance intense. Ton système nerveux récupère bien.",
        });
      } else {
        insights.push({
          type: "warning",
          text: "Ta HRV a chuté et tarde à remonter. Ton système nerveux a besoin de plus de récupération. Prolonge ta phase de repos ou allège tes entraînements.",
        });
      }
    }

    // Sleep debt warning
    if (sleepDebt < -120) {
      insights.push({
        type: "warning",
        text: `Tu accumules une dette de sommeil de ${formatSleepDebt(sleepDebt)}. Cela peut impacter ta récupération et tes performances. Essaie de te coucher plus tôt ces prochains jours.`,
      });
    }

    // High resting HR warning
    if (
      todayData.resting_hr &&
      avgRestingHR > 0 &&
      todayData.resting_hr > avgRestingHR + 5
    ) {
      insights.push({
        type: "warning",
        text: "Ta fréquence cardiaque au repos est élevée ce matin. Cela peut indiquer un début de surentraînement, de déshydratation ou une infection. Surveille ton état de fatigue.",
      });
    }

    // Training load balance
    if (todayLoad) {
      if (todayLoad.tsb !== null && todayLoad.tsb < -15) {
        insights.push({
          type: "warning",
          text: `Ton TSB est à ${todayLoad.tsb.toFixed(0)}. Tu accumules de la fatigue. Prévois des jours de récupération pour éviter le surentraînement.`,
        });
      } else if (todayLoad.tsb !== null && todayLoad.tsb > 15) {
        insights.push({
          type: "info",
          text: `Ton TSB est à ${todayLoad.tsb.toFixed(0)}. Tu es bien reposé. C'est le bon moment pour programmer une séance clé ou une compétition.`,
        });
      }

      if (todayLoad.ctl !== null && todayLoad.ctl < 40) {
        insights.push({
          type: "info",
          text: "Ton CTL est encore bas. Continue à construire progressivement ta charge d'entraînement pour améliorer ton fitness de base.",
        });
      }
    }

    // Recovery trend
    const lastWeekRecovery = displayMetrics
      .slice(-7)
      .map((m) => m.recovery_score)
      .filter((s): s is number => s !== null);

    if (lastWeekRecovery.length >= 5) {
      const avgLastWeek =
        lastWeekRecovery.reduce((sum, s) => sum + s, 0) /
        lastWeekRecovery.length;

      if (avgLastWeek < 50) {
        insights.push({
          type: "warning",
          text: "Ta récupération est faible depuis une semaine. Ton corps a besoin de plus de repos. Envisage une semaine de décharge.",
        });
      } else if (avgLastWeek >= 70) {
        insights.push({
          type: "success",
          text: "Ta récupération est excellente cette semaine. Tu es dans une phase où tu peux tolérer plus de charge d'entraînement.",
        });
      }
    }

    // Good news if everything is fine
    if (
      insights.length === 0 &&
      todayData.recovery_score &&
      todayData.recovery_score >= 70
    ) {
      insights.push({
        type: "success",
        text: "Tous tes indicateurs sont au vert. Continue comme ça, tu gères bien l'équilibre entre entraînement et récupération !",
      });
    }

    return insights;
  };

  const coachInsights = generateCoachInsights();

  const averageBedtimeMinutes = useMemo(() => {
    const samples = displayMetrics
      .map((m) => (m.sleep_start_at ? new Date(m.sleep_start_at) : null))
      .filter((value): value is Date => value !== null);

    if (!samples.length) return null;

    const totalMinutes = samples.reduce((sum, date) => {
      return sum + date.getHours() * 60 + date.getMinutes();
    }, 0);

    if (!Number.isFinite(totalMinutes)) return null;

    return Math.round(totalMinutes / samples.length);
  }, [displayMetrics]);

  const averageBedtime =
    averageBedtimeMinutes !== null
      ? formatClockTime(averageBedtimeMinutes)
      : null;

  const handleTrendHover = (
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    state: any,
    persist = false
  ) => {
    const payload = state?.activePayload as
      | { payload: DailyMetrics }[]
      | undefined;
    if (payload && payload.length > 0) {
      const datum = payload[0].payload;
      const label = formatDate(datum.date);
      if (persist) {
        setTrendSelection(datum);
        setTrendSelectionLabel(label);
      } else {
        setTrendHover(datum);
        setTrendHoverLabel(label);
      }
    }
  };

  const clearTrendHover = () => {
    setTrendHover(null);
    setTrendHoverLabel("");
  };

  const activeTrendPoint =
    trendHover || trendSelection || todayData || null;
  const activeTrendLabel =
    trendHoverLabel ||
    trendSelectionLabel ||
    (activeTrendPoint ? formatDate(activeTrendPoint.date) : "");

  const bmi =
    physio?.weight_kg && physio?.height_cm
      ? physio.weight_kg /
        Math.pow(Number(physio.height_cm) / 100, 2)
      : null;

  const sleepQualityBadge = (() => {
    if (!todayData?.sleep_score) {
      return { label: "En attente", variant: "outline" as const };
    }
    if (todayData.sleep_score >= 80)
      return { label: "Bonne qualité", variant: "success" as const };
    if (todayData.sleep_score >= 65)
      return { label: "Correct", variant: "warning" as const };
    return { label: "À surveiller", variant: "error" as const };
  })();

  if (isLoading) {
    return (
      <div className="flex items-center justify-center h-96">
        <Spinner size="lg" />
        <p className="ml-4 text-muted">Chargement des données de santé...</p>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <h1 className="text-2xl font-bold mb-2">Aperçu Santé</h1>
          <p className="text-muted">
            Suivi de la récupération, du sommeil et de la charge physiologique.
          </p>
        </div>

        <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
          <Tabs
            value={period}
            onValueChange={(v) => setPeriod(v as "7" | "30")}
          >
            <TabsList>
              <TabsTrigger value="7">7 derniers jours</TabsTrigger>
              <TabsTrigger value="30">30 derniers jours</TabsTrigger>
            </TabsList>
          </Tabs>

          <Button
            variant="secondary"
            leftIcon={<RefreshCw className="h-4 w-4" />}
            onClick={syncWhoop}
          >
            Synchro WHOOP
            {lastSync && (
              <span className="text-xs text-muted ml-2">
                {formatTimeSince(lastSync)}
              </span>
            )}
          </Button>
        </div>
      </div>

      {/* Readiness Score - Score principal */}
      {readinessScore !== null && (
        <Card className="bg-gradient-to-br from-accent/10 to-success/10 border-accent/20">
          <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div className="flex-1">
              <div className="flex items-center gap-3 mb-3">
                <div className="p-3 bg-accent/20 rounded-xl">
                  <Zap className="h-6 w-6 text-accent" />
                </div>
                <div>
                  <h2 className="text-sm font-medium text-muted uppercase tracking-wide">
                    Score de Préparation
                  </h2>
                  <p className="text-5xl font-bold text-accent">
                    {readinessScore}
                    <span className="text-2xl text-muted">/100</span>
                  </p>
                </div>
              </div>
              <p className="text-base leading-relaxed">
                {getReadinessInterpretation(readinessScore)}
              </p>
            </div>
            {todayLoad && (
              <div className="flex flex-col gap-2 lg:border-l lg:border-dark-200 lg:pl-6">
                <div className="p-4 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase mb-1">
                    Forme Chronique (CTL)
                  </p>
                  <p className="text-3xl font-bold">
                    {todayLoad.ctl?.toFixed(0) ?? "--"}
                  </p>
                  <p className="text-xs text-muted mt-1">
                    {todayLoad.ctl && todayLoad.ctl >= 80
                      ? "Excellent niveau de fitness"
                      : todayLoad.ctl && todayLoad.ctl >= 60
                        ? "Bon niveau de fitness"
                        : "Fitness en construction"}
                  </p>
                </div>
                <div className="p-4 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase mb-1">
                    Balance (TSB)
                  </p>
                  <p className="text-3xl font-bold">
                    {todayLoad.tsb !== null
                      ? (todayLoad.tsb > 0 ? "+" : "") + todayLoad.tsb.toFixed(0)
                      : "--"}
                  </p>
                  <p className="text-xs text-muted mt-1">
                    {todayLoad.tsb !== null && todayLoad.tsb < -10
                      ? "Fatigue accumulée"
                      : todayLoad.tsb !== null && todayLoad.tsb > 10
                        ? "Très reposé"
                        : "Équilibre optimal"}
                  </p>
                </div>
              </div>
            )}
          </div>
        </Card>
      )}

      {/* Main metrics cards */}
      <div className="flex flex-col gap-4">
        <Card>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm text-muted">Score de récupération</span>
            <Heart className="h-5 w-5 text-success" />
          </div>
          {todayData?.recovery_score ? (
            <>
              <p className="text-4xl font-bold mb-1">
                {todayData.recovery_score}%
              </p>
              {recoveryStatus && (
                <Badge variant={recoveryStatus.variant} size="sm">
                  {recoveryStatus.label}
                </Badge>
              )}
            </>
          ) : (
            <p className="text-sm text-muted">
              Connectez WHOOP pour afficher votre récupération.
            </p>
          )}
        </Card>

        <Card>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm text-muted">VFC (HRV)</span>
            <Activity className="h-5 w-5 text-secondary" />
          </div>
          {todayData?.hrv_ms ? (
            <>
              <p className="text-4xl font-bold mb-1">
                {todayData.hrv_ms}
                <span className="text-lg text-muted"> ms</span>
              </p>
              {hrvValues.length > 1 && (
                <>
                  {todayData.hrv_ms >= hrvBaselineMin ? (
                    <Badge variant="success" size="sm" className="flex items-center gap-1">
                      <CheckCircle className="h-3 w-3" />
                      Dans ta zone habituelle
                    </Badge>
                  ) : (
                    <Badge variant="error" size="sm" className="flex items-center gap-1">
                      <AlertTriangle className="h-3 w-3" />
                      En dessous de ta baseline
                    </Badge>
                  )}
                  <p className="text-xs text-muted mt-2">
                    Baseline : {Math.round(hrvBaselineMin)}-
                    {Math.round(hrvBaselineMax)} ms
                  </p>
                </>
              )}
              {hrvStatus && (
                <p className="text-xs text-muted mt-1">
                  {hrvStatus.change}
                </p>
              )}
            </>
          ) : (
            <p className="text-sm text-muted">
              Aucune donnée VFC sur cette période.
            </p>
          )}
        </Card>

        <Card>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm text-muted">Sommeil total</span>
            <Moon className="h-5 w-5 text-secondary" />
          </div>
          {todayData?.sleep_duration_minutes ? (
            <>
              <p className="text-4xl font-bold mb-1">
                {formatSleepDuration(todayData.sleep_duration_minutes)}
              </p>
              {displayMetrics.length > 0 && (
                <>
                  {sleepDebt < -60 ? (
                    <Badge variant="error" size="sm">
                      Dette : {formatSleepDebt(sleepDebt)}
                    </Badge>
                  ) : sleepDebt > 60 ? (
                    <Badge variant="success" size="sm">
                      Surplus : {formatSleepDebt(sleepDebt)}
                    </Badge>
                  ) : (
                    <Badge variant="success" size="sm">
                      Équilibré
                    </Badge>
                  )}
                  <p className="text-xs text-muted mt-2">
                    Dette cumulée (14 derniers jours, pondérée) :{" "}
                    {formatSleepDebt(sleepDebt)}
                  </p>
                </>
              )}
              <p className="text-xs text-muted mt-1">
                Heure moyenne de coucher: {averageBedtime || "--"}
              </p>
            </>
          ) : (
            <p className="text-sm text-muted">
              Synchronisez vos nuits pour afficher ces données.
            </p>
          )}
        </Card>

        <Card>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm text-muted">FC au repos</span>
            <Heart className="h-5 w-5 text-error" />
          </div>
          {todayData?.resting_hr && avgRestingHR > 0 ? (
            <>
              <p className="text-4xl font-bold mb-1">
                {todayData.resting_hr}
                <span className="text-lg text-muted"> bpm</span>
              </p>
              {todayData.resting_hr > avgRestingHR + 5 ? (
                <>
                  <Badge variant="error" size="sm" className="flex items-center gap-1">
                    <TrendingUp className="h-3 w-3" />
                    Élevée
                  </Badge>
                  <p className="text-xs text-error mt-2">
                    +{todayData.resting_hr - avgRestingHR} bpm par rapport à ta
                    moyenne
                  </p>
                  <p className="text-xs text-muted mt-1">
                    Ton cœur bat plus vite ce matin, surveille ton hydratation et
                    ton niveau de stress.
                  </p>
                </>
              ) : (
                <>
                  <Badge variant="success" size="sm">
                    Normal
                  </Badge>
                  <p className="text-xs text-muted mt-2">
                    {todayData.resting_hr - avgRestingHR > 0 ? "+" : ""}
                    {todayData.resting_hr - avgRestingHR} bpm par rapport à ta
                    moyenne ({avgRestingHR} bpm)
                  </p>
                </>
              )}
            </>
          ) : (
            <p className="text-sm text-muted">
              Aucune donnée de FC au repos aujourd&apos;hui.
            </p>
          )}
        </Card>

        <Card>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm text-muted">Stress quotidien</span>
            <Zap className="h-5 w-5 text-warning" />
          </div>
          {todayData?.strain ? (
            <>
              <p className="text-4xl font-bold mb-1">
                {todayData.strain.toFixed(1)}
              </p>
              {stressStatus && (
                <Badge
                  variant={todayData.strain > 3 ? "warning" : "success"}
                  size="sm"
                >
                  {stressStatus.label}
                </Badge>
              )}
            </>
          ) : (
            <p className="text-sm text-muted">
              Aucune mesure de strain pour aujourd&apos;hui.
            </p>
          )}
        </Card>
      </div>

      {/* Subjective metrics form */}
      <Card>
        <div className="flex items-center justify-between mb-4">
          <div>
            <h3 className="font-semibold">Ressenti du jour</h3>
            <p className="text-xs text-muted mt-1">
              Note ton niveau de stress, fatigue et humeur
            </p>
          </div>
          <Button
            variant="secondary"
            size="sm"
            onClick={() => {
              if (!showSubjectiveForm && todayData) {
                setSubjectiveData({
                  stress_level: todayData.stress_level || 5,
                  fatigue_level: todayData.fatigue_level || 5,
                  mood: todayData.mood || 3,
                  notes: todayData.notes || "",
                });
              }
              setShowSubjectiveForm(!showSubjectiveForm);
            }}
          >
            {showSubjectiveForm ? "Masquer" : "Saisir mon ressenti"}
          </Button>
        </div>

        {showSubjectiveForm && (
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4 p-4 bg-dark-100 rounded-xl">
            <div>
              <label className="text-xs text-muted uppercase block mb-2">
                Stress (1-10)
              </label>
              <input
                type="number"
                min="1"
                max="10"
                value={subjectiveData.stress_level}
                onChange={(e) =>
                  setSubjectiveData({
                    ...subjectiveData,
                    stress_level: parseInt(e.target.value) || 5,
                  })
                }
                className="w-full px-3 py-2 bg-dark-200 border border-dark-300 rounded-lg text-sm"
                placeholder="5"
              />
            </div>
            <div>
              <label className="text-xs text-muted uppercase block mb-2">
                Fatigue (1-10)
              </label>
              <input
                type="number"
                min="1"
                max="10"
                value={subjectiveData.fatigue_level}
                onChange={(e) =>
                  setSubjectiveData({
                    ...subjectiveData,
                    fatigue_level: parseInt(e.target.value) || 5,
                  })
                }
                className="w-full px-3 py-2 bg-dark-200 border border-dark-300 rounded-lg text-sm"
                placeholder="5"
              />
            </div>
            <div>
              <label className="text-xs text-muted uppercase block mb-2">
                Humeur (1-5)
              </label>
              <input
                type="number"
                min="1"
                max="5"
                value={subjectiveData.mood}
                onChange={(e) =>
                  setSubjectiveData({
                    ...subjectiveData,
                    mood: parseInt(e.target.value) || 3,
                  })
                }
                className="w-full px-3 py-2 bg-dark-200 border border-dark-300 rounded-lg text-sm"
                placeholder="3"
              />
            </div>
            <div className="sm:col-span-3">
              <label className="text-xs text-muted uppercase block mb-2">
                Notes (douleurs, blessures, remarques...)
              </label>
              <textarea
                value={subjectiveData.notes}
                onChange={(e) =>
                  setSubjectiveData({
                    ...subjectiveData,
                    notes: e.target.value,
                  })
                }
                className="w-full px-3 py-2 bg-dark-200 border border-dark-300 rounded-lg text-sm"
                rows={3}
                placeholder="Ex: Douleur au genou gauche, nuit agitée..."
              />
            </div>
            <div className="sm:col-span-3 flex justify-end gap-2">
              <Button
                variant="secondary"
                size="sm"
                onClick={() => setShowSubjectiveForm(false)}
              >
                Annuler
              </Button>
              <Button
                variant="primary"
                size="sm"
                onClick={saveSubjectiveMetrics}
              >
                Enregistrer
              </Button>
            </div>
          </div>
        )}

        {todayData &&
          (todayData.stress_level ||
            todayData.fatigue_level ||
            todayData.mood ||
            todayData.notes) && (
            <div className="grid grid-cols-3 gap-4 mt-4 text-center">
              {todayData.stress_level && (
                <div className="p-3 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase">Stress</p>
                  <p className="text-2xl font-bold">
                    {todayData.stress_level}
                    <span className="text-sm text-muted">/10</span>
                  </p>
                </div>
              )}
              {todayData.fatigue_level && (
                <div className="p-3 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase">Fatigue</p>
                  <p className="text-2xl font-bold">
                    {todayData.fatigue_level}
                    <span className="text-sm text-muted">/10</span>
                  </p>
                </div>
              )}
              {todayData.mood && (
                <div className="p-3 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase">Humeur</p>
                  <p className="text-2xl font-bold">
                    {todayData.mood}
                    <span className="text-sm text-muted">/5</span>
                  </p>
                </div>
              )}
              {todayData.notes && (
                <div className="col-span-3 p-3 bg-dark-100 rounded-xl text-left">
                  <p className="text-xs text-muted uppercase mb-1">Notes</p>
                  <p className="text-sm">{todayData.notes}</p>
                </div>
              )}
            </div>
          )}
      </Card>

      {/* HRV Chart with baseline */}
      <Card>
          <div className="mb-2">
            <h3 className="font-semibold">Variabilité Cardiaque (HRV)</h3>
            <p className="text-xs text-muted mt-1">
              Indicateur de l&apos;état du système nerveux autonome
            </p>
          </div>

          {!hrvValues.length ? (
            <div className="py-12 text-center text-sm text-muted">
              Aucune donnée HRV sur cette période.
            </div>
          ) : (
            <>
              {activeTrendPoint && (
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4 text-sm bg-dark-100 rounded-xl p-4">
                  <div>
                    <p className="text-xs text-muted uppercase">Jour</p>
                    <p className="font-semibold">
                      {activeTrendLabel || "—"}
                    </p>
                  </div>
                  <div>
                    <p className="text-xs text-muted uppercase">HRV</p>
                    <p className="font-semibold text-secondary">
                      {activeTrendPoint.hrv_ms ?? "--"} ms
                    </p>
                  </div>
                  <div>
                    <p className="text-xs text-muted uppercase">Status</p>
                    <p className="font-semibold flex items-center gap-1">
                      {activeTrendPoint.hrv_ms &&
                      activeTrendPoint.hrv_ms >= hrvBaselineMin ? (
                        <>
                          <CheckCircle className="h-3 w-3 text-success" />
                          Normal
                        </>
                      ) : (
                        <>
                          <TrendingDown className="h-3 w-3 text-error" />
                          Bas
                        </>
                      )}
                    </p>
                  </div>
                </div>
              )}

              <div className="h-80">
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart
                    data={displayMetrics}
                    onMouseMove={(state) => handleTrendHover(state)}
                    onMouseLeave={() => clearTrendHover()}
                    onClick={(state) => handleTrendHover(state, true)}
                    className="focus:outline-none"
                  >
                    <CartesianGrid
                      strokeDasharray="3 3"
                      stroke="var(--dark-200)"
                    />
                    <XAxis
                      dataKey="date"
                      tickFormatter={formatDate}
                      stroke="var(--muted)"
                      fontSize={12}
                    />
                    <YAxis stroke="var(--muted)" fontSize={12} />
                    <Tooltip wrapperStyle={{ display: "none" }} />
                    {/* Baseline zone */}
                    {hrvStdDev > 0 && (
                      <>
                        <defs>
                          <linearGradient
                            id="baselineGradient"
                            x1="0"
                            y1="0"
                            x2="0"
                            y2="1"
                          >
                            <stop
                              offset="0%"
                              stopColor="var(--muted)"
                              stopOpacity={0.1}
                            />
                            <stop
                              offset="100%"
                              stopColor="var(--muted)"
                              stopOpacity={0.05}
                            />
                          </linearGradient>
                        </defs>
                        <Line
                          type="monotone"
                          dataKey={() => hrvBaselineMax}
                          stroke="var(--muted)"
                          strokeWidth={1}
                          strokeDasharray="3 3"
                          dot={false}
                          name="Baseline Max"
                        />
                        <Line
                          type="monotone"
                          dataKey={() => hrvBaselineMin}
                          stroke="var(--muted)"
                          strokeWidth={1}
                          strokeDasharray="3 3"
                          dot={false}
                          fill="url(#baselineGradient)"
                          name="Baseline Min"
                        />
                      </>
                    )}
                    <Line
                      type="monotone"
                      dataKey="hrv_ms"
                      name="HRV (ms)"
                      stroke="var(--secondary)"
                      strokeWidth={3}
                      dot={{ r: 4, fill: "var(--secondary)" }}
                    />
                  </LineChart>
                </ResponsiveContainer>
              </div>
              {hrvStdDev > 0 && (
                <p className="text-xs text-muted mt-2 text-center">
                  Zone grisée = ta baseline normale ({Math.round(hrvBaselineMin)}-
                  {Math.round(hrvBaselineMax)} ms)
                </p>
              )}
            </>
          )}
        </Card>

      {/* Trends chart - Recovery & Resting HR */}
      <Card>
          <div className="mb-2">
            <h3 className="font-semibold">Tendances physiologiques</h3>
            <div className="flex flex-wrap gap-4 text-xs text-muted mt-2">
              <div className="flex items-center gap-2">
                <span className="h-2 w-2 rounded-full bg-accent" />
                <span>Récupération</span>
              </div>
              <div className="flex items-center gap-2">
                <span className="h-2 w-2 rounded-full bg-warning" />
                <span>FC repos</span>
              </div>
            </div>
          </div>

          {!displayMetrics.length ? (
            <div className="py-12 text-center text-sm text-muted">
              Aucune donnée sur cette période.
            </div>
          ) : (
            <>
              {activeTrendPoint && (
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4 text-sm bg-dark-100 rounded-xl p-4">
                  <div>
                    <p className="text-xs text-muted uppercase">Jour</p>
                    <p className="font-semibold">
                      {activeTrendLabel || "—"}
                    </p>
                  </div>
                  <div>
                    <p className="text-xs text-muted uppercase">
                      Récupération
                    </p>
                    <p className="font-semibold text-accent">
                      {activeTrendPoint.recovery_score ?? "--"}%
                    </p>
                  </div>
                  <div>
                    <p className="text-xs text-muted uppercase">FC repos</p>
                    <p className="font-semibold text-warning">
                      {activeTrendPoint.resting_hr ?? "--"} bpm
                    </p>
                  </div>
                </div>
              )}

              <div className="h-80">
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart
                    data={displayMetrics}
                    onMouseMove={(state) => handleTrendHover(state)}
                    onMouseLeave={() => clearTrendHover()}
                    onClick={(state) => handleTrendHover(state, true)}
                    className="focus:outline-none"
                  >
                    <CartesianGrid
                      strokeDasharray="3 3"
                      stroke="var(--dark-200)"
                    />
                    <XAxis
                      dataKey="date"
                      tickFormatter={formatDate}
                      stroke="var(--muted)"
                      fontSize={12}
                    />
                    <YAxis
                      yAxisId="left"
                      stroke="var(--muted)"
                      fontSize={12}
                      domain={[0, 100]}
                    />
                    <YAxis
                      yAxisId="right"
                      orientation="right"
                      stroke="var(--muted)"
                      fontSize={12}
                      domain={[40, 80]}
                    />
                    <Tooltip wrapperStyle={{ display: "none" }} />
                    <Line
                      yAxisId="left"
                      type="monotone"
                      dataKey="recovery_score"
                      name="Récupération %"
                      stroke="var(--accent)"
                      strokeWidth={2}
                      dot={{ r: 3, fill: "var(--accent)" }}
                    />
                    <Line
                      yAxisId="right"
                      type="monotone"
                      dataKey="resting_hr"
                      name="FC Repos"
                      stroke="var(--warning)"
                      strokeWidth={2}
                      strokeDasharray="5 5"
                      dot={false}
                    />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            </>
          )}
        </Card>

      {/* Coach AI Insights */}
      {coachInsights.length > 0 && (
        <Card>
            <div className="flex items-center gap-3 mb-4">
              <div className="p-2 bg-accent/20 rounded-lg">
                <Zap className="h-5 w-5 text-accent" />
              </div>
              <div>
                <h3 className="font-semibold">Insights Coach IA</h3>
                <p className="text-xs text-muted">
                  Corrélation entre ta santé et ton entraînement
                </p>
              </div>
            </div>
            <div className="space-y-3">
              {coachInsights.map((insight, idx) => (
                <div
                  key={idx}
                  className={`p-4 rounded-xl border ${
                    insight.type === "warning"
                      ? "bg-warning/10 border-warning/30"
                      : insight.type === "success"
                        ? "bg-success/10 border-success/30"
                        : "bg-accent/10 border-accent/30"
                  }`}
                >
                  <p className="text-sm leading-relaxed">{insight.text}</p>
                </div>
              ))}
            </div>
          </Card>
        )}

      {/* Biometry and sleep */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Card>
            <div className="flex items-center justify-between mb-4">
              <h3 className="font-semibold">Biométrie</h3>
              <button className="text-sm text-accent hover:underline">
                Mettre à jour
              </button>
            </div>
            {physio ? (
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
                <div className="p-3 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase">Poids</p>
                  <p className="text-2xl font-bold">
                    {physio.weight_kg ?? "--"}
                    <span className="text-sm text-muted ml-1">kg</span>
                  </p>
                </div>
                <div className="p-3 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase">Taille</p>
                  <p className="text-2xl font-bold">
                    {physio.height_cm ?? "--"}
                    <span className="text-sm text-muted ml-1">cm</span>
                  </p>
                </div>
                <div className="p-3 bg-dark-100 rounded-xl">
                  <p className="text-xs text-muted uppercase">IMC</p>
                  <p className="text-2xl font-bold">
                    {bmi ? bmi.toFixed(1) : "--"}
                  </p>
                </div>
              </div>
            ) : (
              <p className="text-sm text-muted text-center">
                Ajoutez vos données biométriques pour suivre votre évolution.
              </p>
            )}
          </Card>

          <Card>
            <div className="flex items-center justify-between mb-4">
              <h3 className="font-semibold">Détails sommeil</h3>
              <Badge variant={sleepQualityBadge.variant} size="sm">
                {sleepQualityBadge.label}
              </Badge>
            </div>
            {!todayData?.sleep_duration_minutes ? (
              <p className="text-sm text-muted">
                Aucune nuit synchronisée pour analyser les phases de sommeil.
              </p>
            ) : (
              <div className="space-y-3">
                {[
                  {
                    label: "Sommeil profond",
                    value: todayData.sleep_deep_minutes ?? 0,
                    info: "Récupération musculaire et hormonale.",
                    variant: "default" as const,
                  },
                  {
                    label: "Sommeil paradoxal",
                    value: todayData.sleep_rem_minutes ?? 0,
                    info: "Consolidation de la mémoire.",
                    variant: "success" as const,
                  },
                  {
                    label: "Sommeil léger",
                    value: todayData.sleep_light_minutes ?? 0,
                    info: "Transition et régulation autonome.",
                    variant: "default" as const,
                  },
                  {
                    label: "Éveils",
                    value: todayData.sleep_awake_minutes ?? 0,
                    info: "Éveils nocturnes cumulés.",
                    variant: "error" as const,
                  },
                ].map((phase) => (
                  <div key={phase.label} className="flex flex-col gap-1">
                    <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                      <span className="text-sm">{phase.label}</span>
                      <div className="flex items-center gap-2">
                        <Progress
                          value={phase.value}
                          max={todayData.sleep_duration_minutes || 1}
                          className="w-28"
                          variant={phase.variant}
                        />
                        <span className="text-sm font-medium w-16 text-right">
                          {phase.variant === "error"
                            ? `${phase.value}m`
                            : formatSleepDuration(phase.value).replace("m", "")}
                        </span>
                      </div>
                    </div>
                    <p className="text-xs text-muted">{phase.info}</p>
                  </div>
                ))}

                <div className="pt-3 mt-3 border-t border-dark-200">
                  <div className="flex items-center gap-2 text-sm">
                    <Check className="h-4 w-4 text-success" />
                    <span>Heure moyenne de coucher</span>
                  </div>
                  <p className="text-xs text-muted ml-6 mt-1">
                    {averageBedtime
                      ? `Vous vous couchez vers ${averageBedtime}.`
                      : "Synchronisez vos nuits pour suivre cette habitude."}
                  </p>
                </div>
              </div>
            )}
          </Card>
        </div>
      </div>
    </div>
  );
}
